# =====================================================================
#  Copie ce fichier en ".env" et remplis tes clés. Ne le partage JAMAIS.
# =====================================================================

# --- Clés Alpaca (onglet "Paper Trading" du dashboard pour les clés paper) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Clé Anthropic (console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=

# --- Environnement ---
# true  = simulation (argent fictif)  <-- garde ça pour commencer
# false = argent réel
ALPACA_PAPER=true

# Override d'URL uniquement si ton compte est sur l'entité EU (sinon laisse vide)
# ALPACA_BASE_URL=https://api.eu.alpaca.markets

# Sécurité : pour trader en RÉEL il faut ALPACA_PAPER=false ET la ligne ci-dessous = yes
I_UNDERSTAND_LIVE_RISK=no

# --- Modèle Claude (vérifie le nom courant sur docs.claude.com) ---
LLM_MODEL=claude-sonnet-5

# --- Univers autorisé : l'agent ne touchera RIEN d'autre que ces tickers ---
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA

# --- Garde-fous ---
MAX_NOTIONAL_PER_ORDER=10      # $ max engagés par ordre
MAX_ORDERS_PER_DAY=3           # nb max d'ordres par jour
MAX_DRAWDOWN_PCT=20            # % de perte qui coupe tout achat (kill switch)

# Décision journalisée mais AUCUN ordre envoyé (utile pour observer avant de lâcher la bride)
DRY_RUN=false

# --- Stratégie "opportuniste sur l'actu" : recherche web avant chaque décision ---
# true = Claude va chercher les news récentes sur la watchlist (recommandé pour ce profil)
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=5          # nb max de recherches par passe (maîtrise le coût)

# --- Fichiers ---
LOG_FILE=trades_log.jsonl
START_EQUITY_FILE=start_equ
